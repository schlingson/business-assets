# Secret used to sign auth session JWTs. Use a long random string in production.
AUTH_SECRET=change-me-to-a-long-random-string

# Shared secret required to trigger the feed-refresh endpoint / cron job.
# Send it as `Authorization: Bearer <CRON_SECRET>` or `?secret=<CRON_SECRET>`.
CRON_SECRET=change-me-too

# Optional: absolute path for the SQLite database file.
# Defaults to <project>/data/news.db
# DATABASE_PATH=/var/data/news.db

# Optional: rss2json API key (the free tier works without one, but is rate limited).
# RSS2JSON_API_KEY=
